{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mbta/schemas/blob/main/schemas/com.mbta.gl10.heartbeat.v1.json",
  "description": "Green Line type-10 train heartbeat",
  "type": "object",
  "properties": {
    "type": { "const": "com.mbta.gl10.heartbeat.v1" },
    "specversion": { "const": "1.0" },
    "source": {
      "$ref": "cloudevents.json#/properties/source",
      "examples": ["gl10.mbta.com", "gl10-dev.mbtace.com"]
    },
    "id": { "$ref": "cloudevents.json#/properties/id" },
    "time": { "$ref": "glides-events.json#/$defs/timestamp" },
    "data": {
      "type": "object",
      "properties": {
        "number": {
          "type": "string",
          "examples": ["4012"]
        },
        "activeCab": {
          "type": "string",
          "enum": ["1", "2"]
        },
        "latitude": {
          "type": "number",
          "minimum": 41,
          "maximum": 43
        },
        "longitude": {
          "type": "number",
          "minimum": -72,
          "maximum": -70,
          "$comment": "The raw heartbeat message conveys this as longitude west, a positive value in [70, 72]. This message will negate that for consistency with other applications."
        },
        "numberOfPassengers": {
          "type": "number",
          "minimum": 0,
          "maximum": 999
        },
        "avi": {
          "type": "string",
          "examples": ["875"],
          "$comment": "The selected (or default) AVI code of the vehicle."
        },
        "temporaryAvi": {
          "type": "string",
          "examples": ["875"],
          "$comment": "An (optional) AVI code set to temporarily override the selected (or default) AVI."
        },
        "endDestinationStopId": { "$ref": "#/$defs/stopId" },
        "serviceType": {
          "type": "string",
          "enum": [
            "REVENUE",
            "TEST_TRAIN",
            "INSTRUCTION_CAR",
            "NOT_IN_SERVICE",
            "EXPRESS"
          ]
        },
        "expressDestinationStopId": { "$ref": "#/$defs/stopId" },
        "loadInKg": {
          "type": "number",
          "minimum": 0,
          "maximum": 99999
        },
        "directionId": {
          "type": "integer",
          "enum": [0, 1],
          "$comment": "0 = westbound, 1 = eastbound"
        },
        "routeId": {
          "type": "string",
          "enum": ["Green-B", "Green-C", "Green-D", "Green-D", "Mattapan"],
          "$comment": "Naming this for consistency with RTR messages. Including Mattapan for now."
        },
        "lastBoardingStopId": { "$ref": "#/$defs/stopId" },
        "lastBoardingDwellTimeInS": {
          "type": "number",
          "minimum": 0,
          "maximum": 999,
          "$comment": "In seconds. Warning: Max value based on GL10 docs. Doesn't seem long enough to account for very long holds."
        },
        "distanceSinceLastBoardingInFt": {
          "type": "number",
          "minimum": 0,
          "maximum": 9999,
          "$comment": "Precision down to 1ft"
        },
        "healthStatusFailures": {
          "type": "object",
          "$comment": "Keys refer to specific subsystems. Any present key is expected to have value `true`, indicating a failure. For absent keys, assume the system is healthy.",
          "properties": {
            "PROP/D": { "$ref": "#/$defs/healthStatusFailure" },
            "BK/LVL": { "$ref": "#/$defs/healthStatusFailure" },
            "DOORS": { "$ref": "#/$defs/healthStatusFailure" },
            "SANDER": { "$ref": "#/$defs/healthStatusFailure" },
            "HVAC": { "$ref": "#/$defs/healthStatusFailure" },
            "APS": { "$ref": "#/$defs/healthStatusFailure" },
            "LVPS": { "$ref": "#/$defs/healthStatusFailure" },
            "BP": { "$ref": "#/$defs/healthStatusFailure" },
            "PANTO": { "$ref": "#/$defs/healthStatusFailure" },
            "HSCB": { "$ref": "#/$defs/healthStatusFailure" }
          }
        },
        "simCellularIpAddress": {
          "type": "string",
          "$comment": "TODO: Do we need this? Would it be a good idea to omit it?"
        },
        "coupledVehicle": {
          "$comment": "Absent if not coupled. Special value 'UNKNOWN' means coupled, but without communication to the coupled car.",
          "anyOf": [
            {
              "type": "string",
              "examples": ["4012"]
            },
            {
              "const": "NUMBER_UNKNOWN"
            }
          ]
        },
        "vehicleClock": { "$ref": "#/$defs/timestamp" },
        "peiActive": {
          "$comment": "Whether the Passenger Emergency Intercom (PEI) is active. If absent, status invalid or unknown.",
          "type": "boolean"
        },
        "speedInMph": {
          "type": "number",
          "minimum": 0,
          "maximum": 99
        },
        "doorStatus": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["OPEN", "CLOSED"]
          }
        }
      },
      "required": ["number", "avi", "vehicleClock", "speedInMph", "doorStatus"]
    }
  },
  "required": ["type", "specversion", "source", "id", "time", "data"],
  "$defs": {
    "healthStatusFailure": {
      "const": true
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "$comment": "RFC3339 timestamp",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[01][0-9]-[0-3][0-9]T[012][0-9]:[0-5][0-9]:[0-6][0-9](.[0-9]*)?(Z|[+-][012][0-9]:[0-5][0-9])$",
      "examples": ["2023-01-20T09:30:00-05:00"]
    },
    "stopId": {
      "type": "string",
      "examples": ["70160", "70161", "70238"],
      "$comment": "Verify that this is alphanumeric and not just numerical IDs"
    }
  }
}
